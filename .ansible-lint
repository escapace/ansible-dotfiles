---
# Installed dependencies keep their own lint policy, including utilities' stronger internal namespace.
exclude_paths:
  - .ansible/

skip_list:
  - command-instead-of-shell
  - experimental
  - git-latest
  - ignore-errors
  - key-order
  - name
  - no-changed-when
  - no-handler
  - package-latest
  - schema
  - yaml[indentation]
  - yaml[line-length]
  - yaml[trailing-spaces]
